# ==============================================================================
# Regla de Horarios PAM (pam_time): Tarea 3.1
# Ubicación destino: /etc/security/time.conf
# ==============================================================================
# Sintaxis: servicios ; ttys ; usuarios/grupos ; horas_permitidas
#
# Permitir acceso fuera de sistemas solo en días hábiles (Wk = Mo-Fr) de 08:00 a 18:00
*;*;!sistemas;Wk0800-1800

