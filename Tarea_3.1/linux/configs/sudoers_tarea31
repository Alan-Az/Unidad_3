# ==============================================================================
# Reglas de Sudoers: Tarea 3.1
# Ubicación destino: /etc/sudoers.d/tarea31_seguridad
# Permisos requeridos: 0440
# ==============================================================================

# 1. Administradores (Grupo sistemas): Control total con auditoría
%sistemas ALL=(ALL:ALL) ALL

# 2. Operaciones: Control granular de monitoreo de servicios y visualización de logs
%operaciones ALL=(ALL) /usr/bin/systemctl status *, /usr/bin/journalctl

# 3. Finanzas: Sin privilegios administrativos (los intentos se registran en syslog)

